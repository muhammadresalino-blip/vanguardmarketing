# Contoh konfigurasi. Salin menjadi .env untuk pengembangan lokal.
# File .env tidak ikut ter-commit.

# --- API -------------------------------------------------------------------
PORT=4000

# WAJIB di produksi. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-nilai-acak-panjang

# Kosongkan untuk SQLite lokal (server/data/vanguard.db).
# Isi dengan connection string PostgreSQL untuk produksi, misalnya dari Render/Neon.
# DATABASE_URL=postgresql://user:password@host:5432/vanguard
# DATABASE_SSL=false

# Origin frontend yang boleh memanggil API (pisahkan dengan koma).
CORS_ORIGIN=http://localhost:5173

# --- Frontend (dipakai saat build) ----------------------------------------
# Kosongkan bila API dan frontend satu domain (Vite proxy / server menyajikan dist).
# Isi dengan URL API bila frontend di Vercel/Netlify dan API di Render.
# VITE_API_URL=https://vanguard-api.onrender.com
